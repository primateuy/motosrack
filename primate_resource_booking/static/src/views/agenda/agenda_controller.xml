<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="primate_resource_booking.AgendaView">
        <div class="o_primate_agenda_view h-100" t-ref="root">
            <Layout display="props.display">
                <t t-set-slot="layout-actions">
                    <SearchBar t-if="searchBarToggler.state.showSearchBar"/>
                </t>

                <div class="o_primate_agenda_toolbar">
                    <div class="o_agenda_nav btn-group">
                        <button class="btn btn-secondary"
                                t-on-click="onPrevious"
                                t-att-title="'Previous'"
                                aria-label="Previous">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button class="btn btn-secondary" t-on-click="onToday">Today</button>
                        <button class="btn btn-secondary"
                                t-on-click="onNext"
                                t-att-title="'Next'"
                                aria-label="Next">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>

                    <span class="o_agenda_period" t-esc="periodLabel"/>

                    <div class="o_agenda_spacer"/>

                    <div class="o_agenda_group">
                        <span class="o_agenda_group_label">Scale</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn"
                                    t-att-class="state.scale === 'week' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onScale('week')">Week</button>
                            <button class="btn"
                                    t-att-class="state.scale === 'fortnight' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onScale('fortnight')">Fortnight</button>
                            <button class="btn"
                                    t-att-class="state.scale === 'month' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onScale('month')">Month</button>
                        </div>
                    </div>

                    <div class="o_agenda_group">
                        <span class="o_agenda_group_label">Density</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn"
                                    t-att-class="state.density === 'compact' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onDensity('compact')">Compact</button>
                            <button class="btn"
                                    t-att-class="state.density === 'cozy' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onDensity('cozy')">Normal</button>
                            <button class="btn"
                                    t-att-class="state.density === 'roomy' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onDensity('roomy')">Roomy</button>
                        </div>
                    </div>

                    <div class="o_agenda_group">
                        <span class="o_agenda_group_label">Style</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn"
                                    t-att-class="state.variant === 'soft' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onVariant('soft')">Soft</button>
                            <button class="btn"
                                    t-att-class="state.variant === 'solid' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onVariant('solid')">Solid</button>
                            <button class="btn"
                                    t-att-class="state.variant === 'minimal' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.onVariant('minimal')">Minimal</button>
                        </div>
                    </div>
                </div>

                <AgendaRenderer t-props="rendererProps"/>
            </Layout>
        </div>
    </t>

</templates>
