<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="primate_resource_booking.AgendaRenderer">
        <div class="o_primate_agenda"
             t-ref="root"
             t-att-data-scale="props.scale"
             t-att-data-density="props.density"
             t-att-data-variant="props.variant"
             t-on-pointermove="onPointerMove"
             t-on-pointerup="onPointerUp"
             t-on-pointercancel="onPointerCancel">

            <div class="o_agenda_scroller">
                <div class="o_agenda_board" t-att-style="boardStyle">

                    <div class="o_agenda_head">
                        <div class="o_agenda_head_rail">
                            <span class="o_agenda_head_count" t-esc="rowCountLabel"/>
                        </div>
                        <div class="o_agenda_head_time">
                            <div class="o_agenda_months">
                                <t t-foreach="months" t-as="month" t-key="month.key">
                                    <div class="o_agenda_month"
                                         t-att-style="'width: calc(var(--o-agenda-col) * ' + month.span + ')'"
                                         t-esc="month.label"/>
                                </t>
                            </div>
                            <div class="o_agenda_days">
                                <t t-foreach="columns" t-as="column" t-key="column.index">
                                    <div class="o_agenda_day"
                                         t-att-class="{'o_agenda_weekend': column.weekend, 'o_agenda_today': column.today}">
                                        <span class="o_agenda_dow" t-esc="column.dow"/>
                                        <span class="o_agenda_num" t-esc="column.day"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="o_agenda_rows">
                        <t t-foreach="rows" t-as="row" t-key="row.id">
                            <div class="o_agenda_row"
                                 t-att-class="{'o_agenda_row_unassigned': row.unassigned}">
                                <div class="o_agenda_rail">
                                    <span class="o_agenda_rail_name" t-esc="row.name"/>
                                </div>
                                <div class="o_agenda_track"
                                     t-on-pointerdown="(ev) => this.onTrackPointerDown(ev, row)">
                                    <div class="o_agenda_cells">
                                        <t t-foreach="columns" t-as="column" t-key="column.index">
                                            <div class="o_agenda_cell"
                                                 t-att-class="{'o_agenda_weekend': column.weekend}"/>
                                        </t>
                                    </div>

                                    <div class="o_agenda_bars">
                                        <t t-foreach="row.bars" t-as="bar" t-key="bar.key">
                                            <div class="o_agenda_bar"
                                                 t-att-class="{
                                                     'o_agenda_bar_overlay': bar.overlay,
                                                     'o_agenda_bar_chained': bar.chained,
                                                     'o_agenda_bar_clip_start': bar.clipStart,
                                                     'o_agenda_bar_clip_stop': bar.clipStop,
                                                     'o_agenda_bar_dragging': state.drag and state.drag.key === bar.key,
                                                 }"
                                                 t-att-data-state="bar.state"
                                                 t-att-style="barStyle(bar)"
                                                 t-att-title="bar.label"
                                                 t-on-pointerdown="(ev) => this.onBarPointerDown(ev, bar)"
                                                 t-on-click="() => this.onBarClick(bar)">
                                                <span class="o_agenda_bar_stripe"/>
                                                <span class="o_agenda_bar_label" t-esc="bar.label"/>
                                                <span t-if="!bar.overlay" class="o_agenda_bar_days">
                                                    <t t-esc="bar.days"/>d
                                                </span>
                                            </div>
                                        </t>

                                        <div t-if="selection and selection.rowId === row.id"
                                             class="o_agenda_selection"
                                             t-att-style="selection.style">
                                            <span class="o_agenda_selection_label"
                                                  t-esc="selection.label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-if="nowStyle" class="o_agenda_now" t-att-style="nowStyle"/>
                </div>
            </div>

            <div class="o_agenda_legend">
                <t t-foreach="legend" t-as="key" t-key="key.value">
                    <span class="o_agenda_key">
                        <span class="o_agenda_swatch"
                              t-att-class="{'o_agenda_swatch_overlay': key.overlay}"
                              t-att-data-state="key.value"/>
                        <t t-esc="key.label"/>
                    </span>
                </t>
                <span class="o_agenda_hint" t-esc="hint"/>
            </div>
        </div>
    </t>

</templates>
