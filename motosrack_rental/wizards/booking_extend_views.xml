<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_booking_extend_form" model="ir.ui.view">
        <field name="name">motosrack.booking.extend.form</field>
        <field name="model">motosrack.booking.extend</field>
        <field name="arch" type="xml">
            <form string="Extend Rental">
                <field name="booking_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not conflict_warning">
                    <strong>Careful:</strong>
                    <field name="conflict_warning" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <group string="Period">
                        <field name="current_stop"/>
                        <field name="new_stop"/>
                        <field name="new_days"/>
                        <field name="chain_days"/>
                    </group>
                    <group string="Price">
                        <field name="criterion"/>
                        <field name="daily_price"/>
                        <field name="amount"/>
                    </group>
                </group>
                <group string="Collection">
                    <field name="payment_state" widget="radio"/>
                    <field name="deposit_amount"
                           invisible="payment_state != 'deposit'"
                           required="payment_state == 'deposit'"/>
                    <field name="journal_id"
                           invisible="payment_state == 'pending'"
                           required="payment_state != 'pending'"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_extend" type="object" string="Extend"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
