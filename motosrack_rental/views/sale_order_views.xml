<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMULARIO DEL PEDIDO: periodo, motos y flujo de entrega/devolucion -->
    <record id="view_order_form_motosrack_rental" model="ir.ui.view">
        <field name="name">sale.order.form.motosrack.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_rental_pickup"
                        type="object"
                        string="Entregar motos"
                        class="btn-primary"
                        data-hotkey="e"
                        invisible="rental_status != 'reserved'"/>
                <button name="action_rental_return"
                        type="object"
                        string="Registrar devolucion"
                        class="btn-primary"
                        data-hotkey="d"
                        invisible="rental_status != 'picked_up'"/>
                <field name="rental_status"
                       widget="statusbar"
                       statusbar_visible="reserved,picked_up,returned"
                       invisible="not is_rental"/>
            </xpath>

            <xpath expr="//group[@name='sale_header']" position="after">
                <group name="motosrack_rental" string="Alquiler">
                    <group>
                        <field name="is_rental" invisible="1"/>
                        <field name="rental_start"
                               readonly="rental_status in ('picked_up', 'returned')"/>
                        <field name="rental_end"
                               readonly="rental_status == 'returned'"/>
                        <field name="rental_days"/>
                    </group>
                    <group>
                        <field name="rental_vehicle_count"
                               invisible="not is_rental"/>
                        <field name="actual_pickup_date"
                               invisible="not actual_pickup_date"/>
                        <field name="actual_return_date"
                               invisible="not actual_return_date"/>
                    </group>
                </group>
            </xpath>

            <!-- Columnas de alquiler en las lineas del pedido -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="before">
                <field name="is_rental" column_invisible="1"/>
                <field name="fleet_model_id" column_invisible="1"/>
                <field name="vehicle_id"
                       optional="show"
                       domain="[('rental_ok', '=', True), ('model_id', '=?', fleet_model_id)]"
                       readonly="parent.rental_status == 'returned'"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="after">
                <field name="pickup_odometer"
                       optional="show"
                       column_invisible="parent.rental_status not in ('reserved', 'picked_up', 'returned')"
                       readonly="parent.rental_status in ('picked_up', 'returned')"/>
                <field name="return_odometer"
                       optional="show"
                       column_invisible="parent.rental_status not in ('picked_up', 'returned')"
                       readonly="parent.rental_status == 'returned'"/>
                <field name="km_driven"
                       optional="hide"
                       column_invisible="parent.rental_status != 'returned'"/>
            </xpath>

            <!-- Mismos campos en el formulario de linea (vista movil) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']"
                   position="after">
                <field name="is_rental" invisible="1"/>
                <field name="fleet_model_id" invisible="1"/>
                <field name="vehicle_id"
                       invisible="not is_rental"
                       domain="[('rental_ok', '=', True), ('model_id', '=?', fleet_model_id)]"
                       options="{'no_create': True}"/>
                <field name="pickup_odometer"
                       invisible="not is_rental or parent.rental_status == 'no'"/>
                <field name="return_odometer"
                       invisible="not is_rental or parent.rental_status not in ('picked_up', 'returned')"/>
            </xpath>

        </field>
    </record>

    <!-- LISTA DE PEDIDOS: estado del alquiler a la vista -->
    <record id="view_order_list_motosrack_rental" model="ir.ui.view">
        <field name="name">sale.order.list.motosrack.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed']" position="before">
                <field name="rental_start" optional="show"/>
                <field name="rental_end" optional="show"/>
                <field name="rental_status" optional="show" widget="badge"
                       decoration-info="rental_status == 'reserved'"
                       decoration-warning="rental_status == 'picked_up'"
                       decoration-success="rental_status == 'returned'"/>
            </xpath>
        </field>
    </record>

    <!-- BUSQUEDA: filtros por etapa del alquiler -->
    <record id="view_sales_order_filter_motosrack_rental" model="ir.ui.view">
        <field name="name">sale.order.search.motosrack.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="motosrack_reserved" string="Reservados"
                        domain="[('rental_status', '=', 'reserved')]"/>
                <filter name="motosrack_picked_up" string="Entregados"
                        domain="[('rental_status', '=', 'picked_up')]"/>
                <filter name="motosrack_returned" string="Devueltos"
                        domain="[('rental_status', '=', 'returned')]"/>
                <separator/>
                <filter name="motosrack_late" string="Devolucion vencida"
                        domain="[('rental_status', '=', 'picked_up'),
                                 ('rental_end', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
            </xpath>
        </field>
    </record>

    <!-- ACCION: pedidos de alquiler -->
    <record id="action_motosrack_rental_order" model="ir.actions.act_window">
        <field name="name">Alquileres</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_rental', '=', True)]</field>
        <field name="context">{'search_default_motosrack_picked_up': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra el primer alquiler
            </p>
            <p>
                Un alquiler es un presupuesto con una tarifa de alquiler, un
                periodo y una moto asignada por linea.
            </p>
        </field>
    </record>

</odoo>
