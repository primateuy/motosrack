<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_groups_privilege_motosrack" model="res.groups.privilege">
        <field name="name">Motos Rack</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- One single operational group: everybody in the shop does the same
         job. Accounting keeps its own standard groups, so whoever has to
         touch the books gets them the usual way. -->
    <record id="group_motosrack_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_motosrack"/>
        <field name="implied_ids" eval="[
            Command.link(ref('primate_resource_booking.group_booking_manager')),
            Command.link(ref('sales_team.group_sale_salesman_all_leads')),
            Command.link(ref('fleet.fleet_group_user')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
        <field name="comment">Runs the shop: agenda, rentals, deliveries, returns and collections.</field>
    </record>

    <!-- The rental prices are pricelist tiers and the rental unit is the
         day. Both are features Odoo hides behind a group, and with the
         pricelist feature off res.partner.property_product_pricelist
         resolves to nothing: every customer would silently get the default
         list. The module enables them for everybody. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('product.group_product_pricelist')),
            Command.link(ref('uom.group_uom')),
        ]"/>
    </record>

</odoo>
