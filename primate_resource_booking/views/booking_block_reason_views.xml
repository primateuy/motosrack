<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_booking_block_reason_list" model="ir.ui.view">
        <field name="name">primate.booking.block.reason.list</field>
        <field name="model">primate.booking.block.reason</field>
        <field name="arch" type="xml">
            <list string="Block Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="blocks_availability"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_booking_block_reason_form" model="ir.ui.view">
        <field name="name">primate.booking.block.reason.form</field>
        <field name="model">primate.booking.block.reason</field>
        <field name="arch" type="xml">
            <form string="Block Reason">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="blocks_availability"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_booking_block_reason" model="ir.actions.act_window">
        <field name="name">Block Reasons</field>
        <field name="res_model">primate.booking.block.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a block reason</p>
            <p>Reasons explain why a resource is unavailable outside of a booking.</p>
        </field>
    </record>

</odoo>
