<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Loaded as data because Etapa 1 already creates these blocks
             automatically on return. Structured maintenance itself is out
             of scope: the reason is here so the data model does not have to
             change when it arrives. -->

        <record id="block_reason_cleaning" model="primate.booking.block.reason">
            <field name="code">cleaning</field>
            <field name="name">Cleaning</field>
            <field name="sequence">15</field>
            <field name="color">5</field>
            <field name="blocks_availability" eval="True"/>
        </record>

    </data>
</odoo>
