<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_groups_privilege_booking" model="res.groups.privilege">
        <field name="name">Resource Booking</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_booking_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_booking"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can read the agenda and create or edit bookings.</field>
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_booking"/>
        <field name="implied_ids" eval="[Command.link(ref('group_booking_user'))]"/>
        <field name="comment">Can additionally manage blocks and block reasons.</field>
    </record>

    <data noupdate="1">

        <!-- Multi-company: a booking is only visible from its own company. -->
        <record id="booking_company_rule" model="ir.rule">
            <field name="name">Booking: multi-company</field>
            <field name="model_id" ref="model_primate_booking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="booking_block_company_rule" model="ir.rule">
            <field name="name">Booking block: multi-company</field>
            <field name="model_id" ref="model_primate_booking_block"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>

</odoo>
