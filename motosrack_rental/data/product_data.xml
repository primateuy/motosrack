<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- One single service product for the rental. The concrete
             motorbike is decided by the booking, not by the product: that
             way a tier price lives in one place instead of once per bike. -->
        <record id="product_rental_moto" model="product.template">
            <field name="name">Alquiler moto</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_services"/>
            <field name="uom_id" ref="uom.product_uom_day"/>
            <field name="list_price">130.0</field>
            <field name="invoice_policy">order</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="description_sale">Alquiler de moto por día.</field>
            <!-- The price of the tier is what the customer pays. The
                 Brazilian chart would otherwise add a 17% ICMS on top.
                 Electronic invoicing is out of scope for Etapa 1; when it
                 arrives, the taxes get configured here. -->
            <field name="taxes_id" eval="[Command.clear()]"/>
            <field name="supplier_taxes_id" eval="[Command.clear()]"/>
        </record>

        <!-- Helmets are real stock: they leave with the bike and come back,
             and a missing one has to end up somewhere other than available
             stock. No per-unit tracking: they are interchangeable. -->
        <record id="product_helmet" model="product.template">
            <field name="name">Casco</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">none</field>
            <field name="categ_id" ref="product.product_category_goods"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
        </record>

        <!-- Suggested surcharge for a late return. Kept as its own product
             so it shows up as a separate line on the order and can be
             edited or removed without touching the rental line. -->
        <record id="product_late_fee" model="product.template">
            <field name="name">Recargo por atraso</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_services"/>
            <field name="uom_id" ref="uom.product_uom_day"/>
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[Command.clear()]"/>
            <field name="supplier_taxes_id" eval="[Command.clear()]"/>
        </record>

    </data>
</odoo>
