<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="service_type_moto_preventivo" model="fleet.service.type">
            <field name="name">Service preventivo de moto</field>
            <field name="category">service</field>
        </record>

        <!-- Plan de arranque: el cliente lo ajusta y le asigna sus modelos -->
        <record id="maintenance_plan_default" model="motosrack.maintenance.plan">
            <field name="name">Service cada 3.000 km o 6 meses</field>
            <field name="service_type_id" ref="service_type_moto_preventivo"/>
            <field name="interval_km">3000</field>
            <field name="interval_months">6</field>
            <field name="alert_km">300</field>
            <field name="alert_days">15</field>
            <field name="note">Cambio de aceite y filtro, revision de frenos, tension y lubricacion de cadena, presion de neumaticos.</field>
        </record>

    </data>
</odoo>
