<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_booking_payment_form" model="ir.ui.view">
        <field name="name">primate.rental.payment.form</field>
        <field name="model">primate.rental.payment</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <field name="booking_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount_residual"/>
                    <field name="amount"/>
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="payment_date"/>
                </group>
                <footer>
                    <button name="action_register" type="object" string="Collect"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
