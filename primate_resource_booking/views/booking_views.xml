<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================= -->
    <!-- Timeline: the agenda. Dragging a range on it opens the        -->
    <!-- quick-create form named by 'form_view_ref' in the action      -->
    <!-- context, which is the extension point every vertical          -->
    <!-- overrides with its own short form.                            -->
    <!-- ============================================================= -->
    <record id="view_booking_agenda" model="ir.ui.view">
        <field name="name">primate.booking.agenda</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <!-- Blocks are drawn on the same row as the bookings: they mark
                 the resource without taking it, and hiding them would make
                 the agenda lie about what is going on. -->
            <agenda date_start="start"
                    date_stop="stop"
                    group_by="resource_id"
                    label="display_name"
                    state="state"
                    overlay_model="primate.booking.block"
                    overlay_date_start="start"
                    overlay_date_stop="stop"
                    overlay_group_by="resource_id"
                    overlay_label="reason_id"/>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Quick create: the default short form opened from the agenda   -->
    <!-- ============================================================= -->
    <record id="view_booking_quick_form" model="ir.ui.view">
        <field name="name">primate.booking.quick.form</field>
        <field name="model">primate.booking</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="New Booking">
                <sheet>
                    <group>
                        <field name="resource_id"/>
                        <field name="partner_id"/>
                        <field name="start"/>
                        <field name="stop"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not conflicting_block_ids">
                        <strong>Careful:</strong> this period overlaps a block
                        of the resource.
                        <field name="conflicting_block_ids" widget="many2many_tags"
                               readonly="1" nolabel="1"/>
                    </div>
                    <group string="Notes" name="notes">
                        <field name="note" nolabel="1" placeholder="Anything worth remembering"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Full form                                                     -->
    <!-- ============================================================= -->
    <record id="view_booking_form" model="ir.ui.view">
        <field name="name">primate.booking.form</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Close"
                            class="btn-primary" invisible="state != 'in_use'"/>
                    <button name="action_draft" type="object" string="Back to Draft"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('draft', 'done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_use,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object"
                                class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_model">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Document</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Reference"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not conflicting_block_ids">
                        <strong>Careful:</strong> this period overlaps a block
                        of the resource.
                        <field name="conflicting_block_ids" widget="many2many_tags"
                               readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="resource_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="is_overdue" invisible="not is_overdue"
                                   decoration-danger="is_overdue"/>
                        </group>
                    </group>
                    <group string="Notes" name="notes">
                        <field name="note" nolabel="1"/>
                    </group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- List                                                          -->
    <!-- ============================================================= -->
    <record id="view_booking_list" model="ir.ui.view">
        <field name="name">primate.booking.list</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" decoration-danger="is_overdue"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="resource_id"/>
                <field name="partner_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="duration_hours" widget="float_time" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'in_use'"
                       decoration-success="state == 'done'"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Calendar                                                      -->
    <!-- ============================================================= -->
    <record id="view_booking_calendar" model="ir.ui.view">
        <field name="name">primate.booking.calendar</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="start" date_stop="stop"
                      color="resource_id" mode="month" quick_create="0"
                      event_open_popup="true">
                <field name="resource_id" filters="1"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Kanban: the day of operation, usable on a phone               -->
    <!-- ============================================================= -->
    <record id="view_booking_kanban" model="ir.ui.view">
        <field name="name">primate.booking.kanban</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state"
                    quick_create="false">
                <field name="state"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong><field name="resource_id"/></strong>
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'secondary', 'confirmed': 'info', 'in_use': 'warning', 'done': 'success', 'cancelled': 'danger'}}"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-muted">
                                <field name="partner_id"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <i class="fa fa-sign-out me-1" title="Start"/>
                                <field name="start" widget="datetime"/>
                            </div>
                            <div class="col-6 text-end">
                                <i class="fa fa-sign-in me-1" title="End"/>
                                <field name="stop" widget="datetime"/>
                            </div>
                        </div>
                        <div class="row" t-if="record.is_overdue.raw_value">
                            <div class="col-12 text-danger">
                                <i class="fa fa-exclamation-triangle me-1"/>Overdue
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Search                                                        -->
    <!-- ============================================================= -->
    <record id="view_booking_search" model="ir.ui.view">
        <field name="name">primate.booking.search</field>
        <field name="model">primate.booking</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="name"/>
                <field name="resource_id"/>
                <field name="partner_id"/>
                <filter name="filter_delivery_today" string="Starting Today"
                        domain="[('is_delivery_today', '=', True)]"/>
                <filter name="filter_return_today" string="Ending Today"
                        domain="[('is_return_today', '=', True)]"/>
                <filter name="filter_today" string="Today"
                        domain="['|', ('is_delivery_today', '=', True), ('is_return_today', '=', True)]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_in_use" string="In Use" domain="[('state', '=', 'in_use')]"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'in', ('draft', 'confirmed', 'in_use'))]"/>
                <group>
                    <filter name="group_resource" string="Resource" context="{'group_by': 'resource_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_start" string="Start" context="{'group_by': 'start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Actions                                                       -->
    <!-- ============================================================= -->
    <record id="action_booking" model="ir.actions.act_window">
        <field name="name">Agenda</field>
        <field name="res_model">primate.booking</field>
        <field name="view_mode">agenda,list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_booking_search"/>
        <field name="context">{'form_view_ref': 'primate_resource_booking.view_booking_quick_form'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book a resource</p>
            <p>
                Drag over the days of a resource row to open a booking on
                that range. A draft booking blocks nothing: the resource is
                only held once the booking is confirmed.
            </p>
        </field>
    </record>

    <record id="action_booking_today" model="ir.actions.act_window">
        <field name="name">Today</field>
        <field name="res_model">primate.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_booking_search"/>
        <field name="context">{'search_default_filter_today': 1, 'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to do today</p>
            <p>Today's starts and ends show up here.</p>
        </field>
    </record>

</odoo>
