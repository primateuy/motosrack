<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_motosrack_rental" model="ir.ui.view">
        <field name="name">product.template.form.motosrack.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_rental"/>
                <field name="fleet_model_id"
                       invisible="not is_rental"
                       options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <!-- ACCION: tarifas de alquiler -->
    <record id="action_motosrack_rental_product" model="ir.actions.act_window">
        <field name="name">Tarifas</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_rental', '=', True)]</field>
        <field name="context">{'default_is_rental': True, 'default_type': 'service', 'default_invoice_policy': 'order'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera tarifa de alquiler
            </p>
            <p>
                Una tarifa es un producto de tipo servicio cuyo precio es el
                valor de un dia de alquiler. Asociala a un modelo de la flota
                para que solo se ofrezcan las motos de ese modelo.
            </p>
        </field>
    </record>

</odoo>
