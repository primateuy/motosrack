<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_motosrack_fleet_check" model="ir.cron">
            <field name="name">MotosRack: revisar mantenimiento y documentacion</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
