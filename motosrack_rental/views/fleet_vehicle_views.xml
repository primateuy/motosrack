<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_fleet_vehicle_form_motosrack" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.motosrack</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bookings" type="object"
                        class="oe_stat_button" icon="fa-calendar">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='license_plate']" position="before">
                <field name="rental_label"/>
                <field name="resource_id" readonly="1" groups="base.group_no_one"/>
                <field name="is_available_now"/>
                <field name="unavailability_reason" invisible="is_available_now"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_list_motosrack" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.motosrack</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="before">
                <field name="rental_label"/>
                <field name="is_available_now" optional="show"/>
                <field name="unavailability_reason" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
