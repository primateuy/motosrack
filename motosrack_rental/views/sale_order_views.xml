<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sale_order_form_motosrack" model="ir.ui.view">
        <field name="name">sale.order.form.motosrack</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_booking" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not booking_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Booking</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="booking_id" readonly="1" invisible="not booking_id"/>
                <field name="vehicle_id" readonly="1" invisible="not vehicle_id"/>
                <field name="rental_parent_id" readonly="1"
                       invisible="not rental_parent_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="price_manual" optional="hide"/>
            </xpath>
            <!-- The order form shows its totals through the tax-totals
                 widget, so the chain figures go next to it instead of after
                 an amount_total field that is not in the arch. -->
            <xpath expr="//group[@name='sale_total']" position="inside">
                <field name="rental_chain_total" invisible="not booking_id"/>
                <field name="rental_chain_paid" invisible="not booking_id"/>
                <field name="rental_chain_residual" invisible="not booking_id"/>
            </xpath>
        </field>
    </record>

</odoo>
