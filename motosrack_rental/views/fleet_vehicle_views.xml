<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form_motosrack_rental" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.motosrack.rental</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rentals"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-motorcycle"
                        invisible="rental_count == 0">
                    <field name="rental_count" widget="statinfo" string="Alquileres"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="rental_ok"/>
                <field name="rental_status"/>
                <field name="current_rental_order_id"
                       invisible="rental_status != 'rented'"/>
            </xpath>

        </field>
    </record>

    <record id="fleet_vehicle_view_list_motosrack_rental" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.motosrack.rental</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="rental_status" optional="show" widget="badge"
                       decoration-success="rental_status == 'available'"
                       decoration-warning="rental_status == 'rented'"
                       decoration-danger="rental_status == 'unavailable'"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_motosrack_rental" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.motosrack.rental</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <!-- En v19 los filtros tienen que ir antes del grupo de
                 agrupaciones: el esquema no admite contenido despues de el. -->
            <xpath expr="//search/group" position="before">
                <separator/>
                <filter name="motosrack_available" string="Disponibles"
                        domain="[('rental_status', '=', 'available')]"/>
                <filter name="motosrack_rented" string="Alquiladas"
                        domain="[('rental_status', '=', 'rented')]"/>
                <filter name="motosrack_rental_ok" string="Habilitadas para alquiler"
                        domain="[('rental_ok', '=', True)]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter name="motosrack_group_rental_status"
                        string="Estado de alquiler"
                        context="{'group_by': 'rental_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- ACCION: la flota de motos de alquiler -->
    <record id="action_motosrack_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Motos</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('rental_ok', '=', True)]</field>
        <field name="context">{'default_rental_ok': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Carga la primera moto de la flota
            </p>
            <p>
                Cada moto es un vehiculo de la flota. Para poder alquilarla
                tiene que estar marcada como disponible para alquiler.
            </p>
        </field>
    </record>

</odoo>
