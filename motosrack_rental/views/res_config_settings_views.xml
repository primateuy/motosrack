<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_res_config_settings_motosrack" model="ir.ui.view">
        <field name="name">res.config.settings.motosrack</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Motos Rack" name="motosrack_rental"
                     logo="/base/static/img/icons/base.png">
                    <block title="Days and rates" name="motosrack_pricing">
                        <setting string="Day Tolerance"
                                 help="Grace given before a started day is charged. Days are ceil((end - start - tolerance) / 24h), never less than one.">
                            <field name="rental_day_tolerance_hours"/>
                        </setting>
                        <setting string="Longest Tier"
                                 help="Longer rentals are priced with this tier. Raise it if a longer tier is added to the pricelists.">
                            <field name="rental_max_tier_days"/>
                        </setting>
                        <setting string="Cap at the Next Tier"
                                 help="Tiers are not always monotonic: 29 days can cost more than 30. Off, the tiers are applied strictly. On, a rental never costs more than the total of the next tier.">
                            <field name="rental_tier_cap_enabled"/>
                        </setting>
                        <setting string="Default Pricelist"
                                 help="Used when the customer has none of their own.">
                            <field name="rental_default_pricelist_id"/>
                        </setting>
                    </block>
                    <block title="Extensions" name="motosrack_extensions">
                        <setting string="Default Criterion"
                                 help="Can be changed on each extension.">
                            <field name="rental_default_extension_criterion"/>
                        </setting>
                    </block>
                    <block title="Operation" name="motosrack_operations">
                        <setting string="Late Return Tolerance"
                                 help="A return later than the planned end plus this tolerance suggests a surcharge.">
                            <field name="rental_late_tolerance_hours"/>
                        </setting>
                        <setting string="Helmets by Default">
                            <field name="rental_default_helmets"/>
                        </setting>
                        <setting string="Helmets at Most">
                            <field name="rental_max_helmets"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_motosrack_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'motosrack_rental', 'bin_size': False}</field>
    </record>

</odoo>
