<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_booking_block_list" model="ir.ui.view">
        <field name="name">primate.booking.block.list</field>
        <field name="model">primate.booking.block</field>
        <field name="arch" type="xml">
            <list string="Blocks" decoration-warning="is_open">
                <field name="resource_id"/>
                <field name="reason_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="is_open" optional="show"/>
                <field name="blocks_availability" optional="hide"/>
                <field name="note" optional="hide"/>
                <field name="company_id" column_invisible="True"/>
                <button name="action_close" type="object" string="Close"
                        icon="fa-check" invisible="not is_open"/>
            </list>
        </field>
    </record>

    <record id="view_booking_block_form" model="ir.ui.view">
        <field name="name">primate.booking.block.form</field>
        <field name="model">primate.booking.block</field>
        <field name="arch" type="xml">
            <form string="Block">
                <header>
                    <button name="action_close" type="object" string="Close Block"
                            class="btn-primary" invisible="not is_open"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Description"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="resource_id"/>
                            <field name="reason_id"/>
                            <field name="blocks_availability"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="stop" placeholder="Leave empty for an open block"/>
                            <field name="is_open" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="What happened?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_booking_block_search" model="ir.ui.view">
        <field name="name">primate.booking.block.search</field>
        <field name="model">primate.booking.block</field>
        <field name="arch" type="xml">
            <search string="Blocks">
                <field name="resource_id"/>
                <field name="reason_id"/>
                <filter name="filter_open" string="Open" domain="[('stop', '=', False)]"/>
                <filter name="filter_blocking" string="Blocking"
                        domain="[('blocks_availability', '=', True)]"/>
                <separator/>
                <filter name="filter_current" string="Current"
                        domain="[('start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')),
                                 '|', ('stop', '=', False),
                                 ('stop', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_resource" string="Resource" context="{'group_by': 'resource_id'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                    <filter name="group_start" string="Start" context="{'group_by': 'start'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_booking_block" model="ir.actions.act_window">
        <field name="name">Blocks</field>
        <field name="res_model">primate.booking.block</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_booking_block_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Block a resource</p>
            <p>
                A block keeps a resource out of service for a reason other than
                a booking. Leave the end date empty for an open block.
            </p>
        </field>
    </record>

</odoo>
