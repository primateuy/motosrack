<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Generic reasons every vertical needs. Verticals add their own. -->

        <record id="block_reason_review" model="primate.booking.block.reason">
            <field name="code">review</field>
            <field name="name">Pending review</field>
            <field name="sequence">10</field>
            <field name="color">3</field>
            <field name="blocks_availability" eval="True"/>
        </record>

        <record id="block_reason_maintenance" model="primate.booking.block.reason">
            <field name="code">maintenance</field>
            <field name="name">Maintenance</field>
            <field name="sequence">20</field>
            <field name="color">1</field>
            <field name="blocks_availability" eval="True"/>
        </record>

        <record id="block_reason_unavailable" model="primate.booking.block.reason">
            <field name="code">unavailable</field>
            <field name="name">Unavailable</field>
            <field name="sequence">30</field>
            <field name="color">9</field>
            <field name="blocks_availability" eval="True"/>
        </record>

        <record id="block_reason_note" model="primate.booking.block.reason">
            <field name="code">note</field>
            <field name="name">Note</field>
            <field name="sequence">90</field>
            <field name="color">4</field>
            <field name="blocks_availability" eval="False"/>
        </record>

    </data>
</odoo>
