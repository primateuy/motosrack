<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Rental tiers, as native pricelist rules with min_quantity.
             The quantity of the rental line is the number of days, so the
             rate of the tier that matches the total applies to every day:
             8 days on the General list are 8 x 100, not 3 x 130 + 5 x 100. -->

        <record id="pricelist_general" model="product.pricelist">
            <field name="name">General</field>
            <field name="currency_id" ref="base.BRL"/>
            <field name="sequence">1</field>
        </record>

        <record id="pricelist_general_item_1" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_general"/>
            <field name="applied_on">1_product</field>
            <field name="product_tmpl_id" ref="primate_vehicle_rental.product_vehicle_rental"/>
            <field name="min_quantity">1</field>
            <field name="compute_price">fixed</field>
            <field name="fixed_price">130.0</field>
        </record>
